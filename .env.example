# OpenCode Go（OpenAI 兼容）：唯一使用的 AI 服务，不接阿里云百炼
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
# 逗号分隔，按顺序 fallback；按官方定价优先便宜模型（deepseek-v4-flash 输入 $0.14/1M）
LLM_MODELS=deepseek-v4-flash,mimo-v2.5,hy3,kimi-k2.7-code

# 可选：礼貌访问 Crossref/OpenAlex 时附带联系邮箱；不设置则不带
CONTACT_EMAIL=

# 本地模拟 GitHub Actions 时设置（写入 GITHUB_ENV 的路径）
GITHUB_ENV=
